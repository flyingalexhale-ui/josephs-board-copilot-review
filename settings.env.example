# ============================================================================================
#  Joseph's Board -- settings.   ./install.sh copies this to settings.env the first time.
#  Edit settings.env (NOT this .example file), save, then run:   ./jb restart
#  One setting per line:  NAME=value   Type values exactly as they are -- no quotes needed,
#  even for a password with spaces or symbols. Anything after " #" is a note, not a value.
# ============================================================================================

# ---- Password for the board web pages (asked once per phone/computer, then remembered).
# Strongly recommended. REQUIRED if you ever turn on Tailscale Funnel (public internet access).
JB_PASSWORD=

# ---- Which parts to run on this Mac (on / off).
RUN_IBKR_BRIDGE=on        # IBKR board. Needs IB Gateway running + logged in on this Mac.
RUN_WEBULL_BRIDGE=on      # Webull board. Needs the Webull keys below.
RUN_SCANNER=on            # ETF mover scanner (uses IBKR and/or Webull, whichever is set up).
RUN_WEBULL_ALGO=off       # Webull trading algo in PAPER mode (never places real orders).
RUN_IBKR_ALGO=off         # IBKR trading algo in PAPER mode (never places real orders).
KEEP_AWAKE=on             # stop this Mac from going to sleep while it's plugged in.

# ---- Which strategy file each paper trader runs (inside webull-algo/ or ibkr-algo/).
WEBULL_ALGO_STRATEGY=strategies/sma_crossover.yaml
IBKR_ALGO_STRATEGY=strategies/sma_crossover.yaml

# ---- Webull OpenAPI keys: developer.webull.com -> API Management -> App Key / App Secret.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION_ID=us
# Only needed for LIVE Webull trading when your API key has more than one account:
WEBULL_ACCOUNT_ID=

# ---- IB Gateway API port. Leave blank to auto-detect (tries 4001, 4002, 7496, 7497).
IBKR_GATEWAY_PORT=
# Only needed for LIVE IBKR trading when your IBKR login has more than one account:
IBKR_ACCOUNT_ID=

# ---- Web port for the boards (http://<this Mac>:8090/). Change only if 8090 is taken.
JB_GATEWAY_PORT=8090

# ---- Automatic IB Gateway login (./jb ibkr-autologin to set up, ./jb ibkr-autologin off to stop)
RUN_IB_AUTOLOGIN=off

# ---- Order ticket: the most one BUY order can cost, in dollars (typing-mistake guard). Sells are never capped:
# they are limited to what you hold. Default 5000.
JB_TICKET_MAX=5000
